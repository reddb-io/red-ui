{
  "source": "reddb-io/design-system",
  "version": "v2026.11.21",
  "framework": "svelte",
  "consumer": "red-ui",
  "kits": ["data"],
  "adapters": ["reddb"],
  "styles": ["application"],
  "fontLoading": "ui",
  "dest": "vendor/ds",
  "hosts": ["mcp", "workspace"],
  "distribution": {
    "format": "compiled",
    "minify": true,
    "include": {
      "app": [
        "ActivityFeed",
        "ChangeReview",
        "CommandPalette",
        "ErrorBoundary",
        "ListRow",
        "NavItem",
        "OutcomeScreen",
        "PageHeading",
        "Pill",
        "SettingsRow",
        "ShortcutHelp",
        "SidebarRail",
        "SplitView",
        "WorkspaceTabs"
      ],
      "app/ApplicationWorkspace": ["default"],
      "app/workspace": ["WorkspaceSession", "createWorkspaceSession"],
      "app/workspace/changes": [
        "reconcileWorkspaceChanges",
        "stageWorkspaceChange"
      ],
      "app/workspace/documents": [
        "WorkspaceDocument",
        "WorkspaceDocuments",
        "closeWorkspaceDocument",
        "focusWorkspaceDocument",
        "openWorkspaceDocument",
        "updateWorkspaceDocument"
      ],
      "app/workspace/execution": ["createWorkspaceExecution"],
      "app/workspace/renderers": ["WorkspaceRendererRegistry"],
      "app/workspace/storage": [
        "MemoryStorage",
        "WorkspaceSnapshotStore",
        "scopedStorage"
      ],
      "base": [
        "Alert",
        "AlertDialog",
        "Badge",
        "Button",
        "Card",
        "Checkbox",
        "CodeBlock",
        "Dialog",
        "Disclosure",
        "EmptyState",
        "Field",
        "Heading",
        "Icon",
        "IconGlyph",
        "Input",
        "Kbd",
        "LoadingIndicator",
        "Logo",
        "NavigationScope",
        "Popover",
        "Progress",
        "SectionHeading",
        "Select",
        "Skeleton",
        "StateIllustration",
        "StatusIndicator",
        "Textarea",
        "ToggleButton",
        "Tone",
        "jsonCodeGrammar"
      ],
      "base/illustrations": [
        "StateIllustrationAsset",
        "accessLocked",
        "collectionEmpty",
        "connectionLost",
        "dataEmpty",
        "documentCollectionEmptyCompact",
        "documentDraft",
        "integrationEmpty",
        "maintenance",
        "pageMissing",
        "projectEmpty",
        "searchEmpty",
        "sessionExpired"
      ],
      "base/interaction": ["isEventFromModal"],
      "base/recipes": ["tokenColor"],
      "data/DeveloperPanel": ["default"],
      "data/DeveloperRequestInspector": ["default"],
      "data/Diagram": ["DiagramData", "default"],
      "data/DiffExplorer": ["default"],
      "data/DocumentViewer": [
        "DocumentPresentation",
        "DocumentValue",
        "default"
      ],
      "data/EventSeriesExplorer": ["default"],
      "data/GraphExplorer": ["default"],
      "data/KeyValueExplorer": ["default"],
      "data/KpiCard": ["default"],
      "data/PanZoomViewport": ["default"],
      "data/QueueExplorer": ["default"],
      "data/StatsExplorer": ["default"],
      "data/Table": ["TableChange", "TableColumn", "TableRow", "default"],
      "data/TableExplorer": ["default"],
      "data/TimeSeries": ["TimeSeriesDataset", "default"],
      "data/VectorExplorer": ["default"],
      "data/diff-explorer": [
        "DiffExplorerEntry",
        "DiffExplorerField",
        "explorerFields",
        "formatExplorerValue",
        "summarizeExplorerEntries"
      ],
      "data/event-series-explorer": ["*", "renderEventSeriesSnapshot"],
      "data/graph-explorer": [
        "GraphData",
        "GraphEdge",
        "GraphNode",
        "GraphNodeRelation",
        "GraphQueryRequest",
        "compareGraphNodesByCentrality",
        "graphNodeCentrality",
        "graphNodeDetail",
        "graphNodeIncomingSizeScales",
        "graphNodeIsOrphan",
        "renderGraphSnapshot"
      ],
      "data/key-value-explorer": ["*", "renderKvSnapshot"],
      "data/recipes": ["CHART_PALETTE_40"],
      "data/stats-explorer": ["formatStatsMetric"],
      "data/table-explorer": ["TableQueryRequest", "renderTableSnapshot"],
      "data/vector-explorer": [
        "VectorSearchRequest",
        "compactValue",
        "parseVectorInput",
        "scalarLabel",
        "vectorMagnitude"
      ]
    }
  }
}

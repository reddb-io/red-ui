          "declaration": "/** One flat native Select option; richer groups arrive as native option children. */\nexport interface SelectOption {\n  /** Native serialized value. */\n  value: string;\n  /** Visible option name. */\n  label: string;\n  /** Keep this option unavailable to native selection. */\n  disabled?: boolean;\n}",

        {
          "declaration": "/** The framework-neutral association passed by Field to its control. */\nexport interface FieldControlProps {\n  /** The id the label targets. */\n  id: string;\n  /** Native required semantics, when the Field declares them. */\n  required?: true;\n  /** Space-separated help and error ids. */\n  \"aria-describedby\"?: string;\n  /** Present only while the Field has an error. */\n  \"aria-invalid\"?: \"true\";\n  /** The Field's current error id. */\n  \"aria-errormessage\"?: string;\n}",
          "name": "FieldControlProps",
          "source": "kits/base/src/core/field.ts"
        },
        {
          "declaration": "/** A group association leaves every native control's id and requirement intact. */\nexport type FieldsetControlProps = Omit<FieldControlProps, \"id\" | \"required\">;",
          "name": "FieldsetControlProps",
          "source": "kits/base/src/core/fieldset.ts"
        }
      ]

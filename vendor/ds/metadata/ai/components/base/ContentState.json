              "name": "rows",
              "required": false,
              "type": "number"
            },
            {
              "default": "4",
              "description": "Placeholder columns in table and heatmap shapes. Integer from 1 to 12; defaults to 4.",
              "name": "columns",
              "required": false,
              "type": "number"
            },
            {
              "default": "true",
              "description": "Enable the opacity pulse. Defaults to true; reduced-motion preferences always stop animation.",
              "name": "animated",
              "required": false,
              "type": "boolean",
              "vocabulary": [
                "true",
                "false"
              ]
            },
            {
              "description": "Current initial-load outcome. The application chooses empty explicitly; zero is valid content.",
              "name": "state",
              "required": true,
              "type": "ContentLoadState",
              "vocabulary": [
                "loading",
                "ready",
                "empty",
                "error"
              ]
            },
            {
              "description": "Required accessible name of the region in every state.",
              "name": "label",
              "required": true,
              "type": "string"
            },
            {
              "description": "Definite height reserved before the request, shared by loading, ready, empty and error. Accepts positive pixels or a CSS length (including Density token calculations); fill means 100% of a bounded parent. Overflow remains keyboard-scrollable. Omitted, content determines height and matching a skeleton shape alone cannot guarantee layout stability.",
              "name": "height",
              "required": false,
              "type": "number | string"
            },
            {
              "default": "\"No results\"",
              "description": "Default empty-state title when no empty content is supplied. Defaults to No results.",
              "name": "emptyTitle",
              "required": false,
              "type": "string"
            },
            {
              "description": "Optional explanation beneath the default empty-state title.",
              "name": "emptyDescription",
              "required": false,
              "type": "string"
            },
            {
              "default": "\"Could not load content.\"",
              "description": "Safe text shown in the default error alert and passed to custom failure content.",
              "name": "errorMessage",
              "required": false,
              "type": "string"
            },
            {
              "description": "Override the live message for the current state; an empty string silences it. Default errors use the alert instead.",
              "name": "announcement",
              "required": false,
              "type": "string"
            },
            {
              "default": "\"Retry\"",
              "description": "Visible and accessible label of the default error's retry action, shown when a retry handler is given. Defaults to Retry.",
              "name": "retryLabel",
              "required": false,
              "type": "string"
            },
            {
              "description": "Ready content. The application owns its components, data and interactions.",
              "name": "children",
              "required": true,
              "type": "ReactNode"
            },
            {
              "description": "Optional loading composition instead of the default Skeleton. Keep its children decorative.",
              "name": "loading",
              "required": false,

        {
          "declaration": "export type IconGlyph = Component<IconGlyphProps>;",
          "name": "IconGlyph",
          "source": "kits/base/src/Icon.svelte"
        },
        {
          "declaration": "export type IconGlyphProps = LucideProps;",
          "name": "IconGlyphProps",
          "source": "kits/base/src/Icon.svelte"
        },
        {
          "declaration": "/** Optional notifications and status shared by the sidebar surfaces. */\nexport interface NavigationMarkers {\n  /** Notification count or short text; undefined omits it. Numeric counts above 99 display 99+ while retaining the exact accessible count. */\n  badge?: number | string;\n  /** Complete accessible notification description, e.g. 91 unread conversations. */\n  badgeLabel?: string;\n  /** Semantic notification tone. Defaults to neutral. */\n  badgeTone?: Tone;\n  /** Presence or health indicator; its required label carries meaning beyond colour. */\n  status?: NavigationStatus;\n}",
          "name": "NavigationMarkers",
          "source": "kits/app/src/composites/navigation.behavior.ts"
        },
        {
          "declaration": "/** Application-owned presence or health, independent of navigation selection. */\nexport interface NavigationStatus {\n  /** Meaning announced alongside the destination, such as Online or Service unavailable. */\n  label: string;\n  /** Semantic tone of the status mark. Defaults to neutral. */\n  tone?: Tone;\n}",
          "name": "NavigationStatus",
          "source": "kits/app/src/composites/navigation.behavior.ts"
        },
        {
          "declaration": "export interface SidebarRailItem extends NavigationMarkers {\n    /** Stable identity emitted when this item is chosen. */\n    id: string;\n    /**\n     * Accessible name and Tooltip content for the visually compact control. A tile that shows\n     * initials in icon-only mode is named `<initials>, <label>` unless `label` already holds them as words, so its\n     * name contains what it shows (WCAG 2.5.3). When a notification is present, its visible count precedes the initials.\n     */\n    label: string;\n    /** Native destination; omit for an action or contextual section menu. */\n    href?: string;\n    /** Optional glyph rendered only through the Base Icon contract. */\n    icon?: IconGlyph;\n    /**\n     * Initials or a short affordance such as \"+\" when no glyph is supplied; defaults to the first\n     * two letters of `label`, upper-cased.\n     */\n    fallback?: string;\n    /** Present but unavailable and omitted from the rail's roving focus order. */\n    disabled?: boolean;\n    /** Disclosure state when the selected rail item toggles an adjacent panel. */\n    expanded?: boolean;\n    /** Id of the adjacent panel controlled by this disclosure item. */\n    controls?: string;\n    /** Draw a horizontal divider before this destination to separate groups in the vertical rail. It adds no focus stop. */\n    separatorBefore?: boolean;\n  }",
          "name": "SidebarRailItem",
          "source": "kits/app/src/core/sidebar-rail.ts"
        },
        {
          "declaration": "export type Tone = (typeof TONES)[number];",
          "name": "Tone",
          "source": "kits/base/src/tone.ts"
        }
      ]
    },

      "types": [
        {
          "declaration": "type ActivityFeedItem = TimelineItem;",
          "name": "ActivityFeedItem",
          "source": "kits/app/src/core/contracts/activityfeed.ts"
        },
        {
          "declaration": "export type CollectionState = (typeof COLLECTION_STATES)[number];",
          "name": "CollectionState",
          "source": "kits/base/src/core/collection-state.ts"
        },
        {
          "declaration": "export interface TimelineItem {\n  /** Stable entry identity. */\n  id: string;\n  /** Visible entry heading. */\n  title: string;\n  /** Machine-readable date or time accepted by native `<time>`. */\n  datetime: string;\n  /** Caller-owned visible rendering of the date or time. */\n  time: string;\n  /** Supporting event detail. */\n  description?: string;\n  /** Optional destination for the entry heading. */\n  href?: string;\n}",
          "name": "TimelineItem",
          "source": "kits/base/src/core/timeline.ts"
        }
      ]
    },
    "events": [
      {
        "description": "Called when the person retries after a failed load.",
        "dialect": "discrete",
        "name": "onretry",
        "type": "() => void"
      }
    ],
    "forwardsAttributesTo": [
      "<ol>"
    ],
    "guidance": {
      "family": "Sequences over time",
      "question": "Is it a path someone follows, a history to read, parallel activity on a time scale, or a live log?",
      "related": [
        "base/Steps",
        "base/Timeline",
        "data/ActivityTimeline",
        "data/EventLog"
      ],
      "whenNotToUse": [
        {
          "instead": "data/ActivityTimeline",
          "text": "Overlapping activities on a time scale."
        }
      ],
      "whenToUse": [
        "Who did what in an application, newest first, built on the canonical Timeline."
      ]
    },
    "implementations": {
      "react": {
        "api": {
          "forwardsNativeProps": true,
          "kind": "Composite",
          "kit": "app",
          "name": "ActivityFeed",
          "nativeAttributes": [
            "ol"
          ],
          "props": [
            {
              "description": "Where the data stands. Unset means ready, and empty when there are no items. `refreshing` keeps the items and marks the collection busy; `error` with items keeps them as stale under an alert.",
              "name": "state",
              "required": false,
              "type": "CollectionState",
              "vocabulary": [
                "loading",
                "ready",
                "empty",
                "error",
                "refreshing"
              ]
            },
            {
              "default": "\"Could not load activity.\"",
              "description": "Message shown when the data failed to load.",
              "name": "errorMessage",
              "required": false,
              "type": "string"
            },
            {
              "default": "\"Retry\"",
              "description": "Visible and accessible label of the retry action. Defaults to Retry.",
              "name": "retryLabel",
              "required": false,
              "type": "string"
            },
            {
              "default": "5",
              "description": "Skeleton rows shown while loading, at the control-height rhythm. Defaults to 5.",
              "name": "loadingRows",
              "required": false,
              "type": "number"
            },
            {
              "description": "Caller-owned activity in chronological display order.",
              "name": "items",
              "required": true,
              "type": "readonly ActivityFeedItem[]"

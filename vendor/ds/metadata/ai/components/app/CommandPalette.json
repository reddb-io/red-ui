      "types": [
        {
          "declaration": "/** One caller-owned command offered by the global command search. */\nexport interface CommandPaletteCommand {\n  /** Stable identity returned when the command is selected. */\n  id: string;\n  /** Visible, searchable command name. */\n  label: string;\n  /** Visible category heading; commands retain their order within each category. */\n  group?: string;\n  /** Supporting, searchable explanation or destination. */\n  description?: string;\n  /** Visual shortcut reference; registration remains caller-owned. */\n  shortcut?: readonly string[];\n  /** Additional search terms, never rendered as labels. */\n  keywords?: readonly string[];\n  /** Removes only this command from interaction and selection. */\n  disabled?: boolean;\n  /** Caller-owned business action. */\n  onselect?: () => void;\n}",
          "name": "CommandPaletteCommand",
          "source": "kits/app/src/composites/command-palette.behavior.ts"
        }
      ]
    },
    "events": [
      {
        "description": "Reports every open-state request.",
        "dialect": "open",
        "name": "onopenchange",
        "type": "(open: boolean) => void"
      },
      {
        "description": "Reports selection after the command action. Modal presentation closes before invoking actions.",
        "dialect": "item-activation",
        "name": "onselect",
        "type": "(command: CommandPaletteCommand) => void"
      }
    ],

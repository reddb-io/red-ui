      "types": [
        {
          "declaration": "export interface ReviewChange {\n  /** Unique stable identity; never a row position. */\n  id: string;\n  /** Human-readable changed entity or property. */\n  label: string;\n  /** Caller-formatted previous value; never executed. */\n  before: string;\n  /** Caller-formatted proposed value; never executed. */\n  after: string;\n  /** Observed result; omitted means pending. */\n  state?: ReviewState;\n  /** Caller-safe failure explanation. */\n  error?: string;\n  /** Optional context for the change. */\n  description?: string;\n}",
          "name": "ReviewChange",
          "source": "kits/app/src/core/change-review.ts"
        },
        {
          "declaration": "export type ReviewState = \"pending\" | \"applying\" | \"applied\" | \"failed\";",
          "name": "ReviewState",
          "source": "kits/app/src/core/change-review.ts"
        }
      ]
    },

          "props": [
            {
              "default": "\"Developer panel\"",
              "description": "Accessible and visible name; defaults to Developer panel.",
              "name": "label",
              "required": false,
              "type": "string"
            },
            {
              "description": "Legacy request snapshot, enabling the built-in Requests context.",
              "name": "requests",

            },
            {
              "default": "[]",
              "description": "Host-defined contexts.",
              "name": "contexts",
              "required": false,
              "type": "readonly DeveloperPanelContext[]"
            },
            {
              "description": "Context values that show the supplied toolbar; omitted means all contexts.",
              "name": "toolbarContexts",
              "required": false,
              "type": "readonly string[]"
            },
            {
              "default": "false",
              "description": "Whether the bottom panel is expanded.",

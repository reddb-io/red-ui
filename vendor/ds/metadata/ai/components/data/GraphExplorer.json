      "types": [
        {
          "declaration": "export interface GraphData {\n  nodes: GraphNode[];\n  edges: GraphEdge[];\n  /** Host-reported result context, announced after an algorithm query. */\n  summary?: string;\n}",
          "name": "GraphData",
          "source": "kits/data/src/graph-explorer.ts"
        },
        {
          "declaration": "export interface GraphEdge {\n  id: string;\n  source: string;\n  target: string;\n  label?: string;\n  /** Full underlying row/object — surfaced when the user clicks an edge. */\n  data?: Record<string, unknown>;\n}",
          "name": "GraphEdge",
          "source": "kits/data/src/graph-explorer.ts"
        },
        {
          "declaration": "export interface GraphNode {\n  id: string;\n  label: string;\n  /** Full underlying row/object — surfaced when the user clicks a node. */\n  data: Record<string, unknown>;\n}",
          "name": "GraphNode",
          "source": "kits/data/src/graph-explorer.ts"
        },
        {
          "declaration": "export type GraphQueryRequest =\n  | { kind: \"query\"; query: string }\n  | { kind: \"neighborhood\"; node: string }\n  | { kind: \"centrality\" }\n  | { kind: \"path\"; from: string; to: string };",
          "name": "GraphQueryRequest",
          "source": "kits/data/src/graph-explorer.ts"
        }
      ]
    },
    "events": [
      {
        "description": "Resolves a query intent to data. Reject on failure; honor the cancellation signal.",
        "dialect": "discrete",
        "name": "onquery",
        "type": "( request: GraphQueryRequest, signal: AbortSignal, ) => Promise<GraphData>"
      }
    ],
    "implementations": {

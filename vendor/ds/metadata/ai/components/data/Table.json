      "types": [
        {
          "declaration": "export type SortDirection = \"ascending\" | \"descending\";",
          "name": "SortDirection",
          "source": "kits/data/src/table.ts"
        },
        {
          "declaration": "/** Read-only state supplied to caller-owned Table toolbar actions. */\nexport interface TableActionsContext {\n  /** All filtered and sorted source rows, across pages; staged edits are supplied in changes. */\n  rows: readonly TableRow[];\n  /** Source rows on the current page, including virtualized rows outside the viewport. */\n  pageRows: readonly TableRow[];\n  /** Caller-controlled selection, or null when nothing is selected. */\n  selectedRow: TableRowKey | null;\n  /** Current immutable staged edits, for save or export actions. */\n  changes: readonly TableChange[];\n  /** Active column filters. */\n  filters: TableFilters;\n  /** Active sort, or null for source order. */\n  sort: TableSort | null;\n}",
          "name": "TableActionsContext",
          "source": "kits/data/src/table.ts"
        },
        {
          "declaration": "/** What a caller-owned `cell` snippet receives for one read-only body cell. */\nexport interface TableCellContext<Row extends TableRow = TableRow> {\n  column: TableColumn<Row>;\n  row: Row;\n  /** The displayed value, staged changes included. */\n  value: unknown;\n  /** The column's formatted text for `value`. */\n  text: string;\n}",
          "name": "TableCellContext",
          "source": "kits/data/src/table.ts"
        },
        {
          "declaration": "export interface TableChange<Value = unknown> {\n  rowKey: TableRowKey;\n  columnKey: string;\n  previous: Value;\n  value: Value;\n}",
          "name": "TableChange",
          "source": "kits/data/src/table.ts"
        },
        {
          "declaration": "export interface TableColumn<Row extends TableRow = TableRow> {\n  /** Stable property key used to read this column from a row. */\n  key: keyof Row & string;\n  /** Visible column heading. */\n  header: string;\n  /** Include this column in the sort cycle. */\n  sortable?: boolean;\n  /** Include a text field for this column in the filter row. */\n  filterable?: boolean;\n  /** Example query shown in this column's empty filter field. */\n  filterPlaceholder?: string;\n  /** Inline alignment. `end` also sets tabular numerals, for quantities that compare by column. */\n  align?: TableColumnAlign;\n  /** Allow this column to enter edit mode when the Table has editing capability. */\n  editable?: boolean;\n  /** Caller-owned comparison for values in this column. */\n  compare?: (left: unknown, right: unknown, leftRow: Row, rightRow: Row) => number;\n  /** Caller-owned filter predicate. The query has already been trimmed. */\n  filter?: (value: unknown, query: string, row: Row) => boolean;\n  /** Convert an editor's text back to the row's value type. */\n  parse?: (input: string, previous: unknown, row: Row) => unknown;\n  /** Format a value for read-only display and the initial editor text. */\n  format?: (value: unknown, row: Row) => string;\n}",
          "name": "TableColumn",
          "source": "kits/data/src/table.ts"
        },
        {
          "declaration": "export type TableColumnAlign = \"start\" | \"end\";",
          "name": "TableColumnAlign",
          "source": "kits/data/src/table.ts"
        },
        {
          "declaration": "export type TableFilters = Readonly<Record<string, string | undefined>>;",
          "name": "TableFilters",
          "source": "kits/data/src/table.ts"
        },
        {
          "declaration": "/** Pure data operations for the Data Kit Table. This module has no Svelte or DOM dependency. */\n\nexport type TableRow = Record<string, unknown>;",
          "name": "TableRow",
          "source": "kits/data/src/table.ts"
        },
        {
          "declaration": "export type TableRowKey = string | number;",
          "name": "TableRowKey",
          "source": "kits/data/src/table.ts"
        },
        {
          "declaration": "export interface TableSort {\n  key: string;\n  direction: SortDirection;\n}",
          "name": "TableSort",
          "source": "kits/data/src/table.ts"
        },
        {
          "declaration": "interface TableVirtualization extends Omit<VirtualWindowOptions, \"scrollTop\"> {\n}",
          "name": "TableVirtualization",
          "source": "kits/data/src/core/contracts/table.ts"
        },
        {
          "declaration": "export interface VirtualWindowOptions {\n  scrollTop: number;\n  viewportHeight: number;\n  rowHeight: number;\n  overscan?: number;\n}",
          "name": "VirtualWindowOptions",
          "source": "kits/data/src/table.ts"
        }
      ]

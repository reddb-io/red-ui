      "types": [
        {
          "declaration": "export type GraphColorToken =\n  | (typeof GRAPH_COLOR_TOKENS)[number]\n  | typeof GRAPH_EDGE_COLOR_TOKEN\n  | typeof GRAPH_MUTED_COLOR_TOKEN;",
          "name": "GraphColorToken",
          "source": "kits/data/src/graph.ts"
        },
        {
          "declaration": "export interface GraphData {\n  nodes: readonly GraphNode[];\n  edges: readonly GraphEdge[];\n}",
          "name": "GraphData",
          "source": "kits/data/src/graph.ts"
        },
        {
          "declaration": "export interface GraphEdge {\n  id?: string;\n  source: string;\n  target: string;\n  label?: string;\n  weight?: number;\n  /** Optional semantic DS token override. Raw colors are intentionally unsupported. */\n  color?: GraphColorToken;\n  /** Caller-owned domain data. The design system transports but never interprets it. */\n  metadata?: GraphMetadata;\n}",
          "name": "GraphEdge",
          "source": "kits/data/src/graph.ts"
        },
        {
          "declaration": "export interface GraphInteraction {\n  kind: \"node\" | \"edge\";\n  action: \"click\" | \"focus\";\n  id: string;\n  metadata?: GraphMetadata;\n}",
          "name": "GraphInteraction",
          "source": "kits/data/src/graph.ts"
        },
        {
          "declaration": "/** Deterministic arrangement selected by the graph contract. */\nexport type GraphLayout = \"stress\" | \"force\" | \"radial\";",
          "name": "GraphLayout",
          "source": "kits/data/src/graph.ts"
        },
        {
          "declaration": "export type GraphMetadata = Record<string, unknown>;",
          "name": "GraphMetadata",
          "source": "kits/data/src/graph.ts"
        },
        {
          "declaration": "export interface GraphNode {\n  /** Stable node identity. */\n  id: string;\n  label?: string;\n  /** Caller-owned community identity. Omit it to let the engine detect communities. */\n  community?: string;\n  /** Optional semantic DS token override. Raw colors are intentionally unsupported. */\n  color?: GraphColorToken;\n  size?: number;\n  x?: number;\n  y?: number;\n  /** Caller-owned domain data. The design system transports but never interprets it. */\n  metadata?: GraphMetadata;\n}",
          "name": "GraphNode",
          "source": "kits/data/src/graph.ts"
        }
      ]

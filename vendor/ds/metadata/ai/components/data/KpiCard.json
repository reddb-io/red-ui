    "implementations": {
      "react": {
        "api": {
          "forwardsNativeProps": false,
          "kind": "Primitive",
          "kit": "data",
          "name": "KpiCard",
          "nativeAttributes": [],
          "props": [
            {
              "description": "Name of the metric, shown above the value and used as the card's accessible name.",
              "name": "label",
              "required": true,
              "type": "string"
            },
            {
              "description": "The headline figure, shown as given: format it before passing it (a number is rendered as is).",
              "name": "value",
              "required": true,
              "type": "string | number"
            },
            {
              "description": "Change against the comparison period, as a number (`4.2` shows `+4.2%`). Its sign sets the direction and, with `polarity`, the colour; omitted or `null`, no delta is shown.",
              "name": "delta",
              "required": false,
              "type": "number | null"
            },
            {
              "default": "\"%\"",
              "description": "Text appended to the delta in its visible figure, such as a unit. Defaults to `%`.",
              "name": "deltaSuffix",
              "required": false,
              "type": "string"
            },
            {
              "default": "\"versus previous period\"",
              "description": "Visible comparison context, also read after the delta. Defaults to `versus previous period`.",
              "name": "deltaLabel",
              "required": false,
              "type": "string"
            },
            {
              "description": "Optional visible context below the value, such as the measured period or a short explanation. The comparison label appears alongside the delta when a delta is supplied.",
              "name": "description",
              "required": false,
              "type": "string"
            },
            {
              "default": "\"higher-is-better\"",
              "description": "Which direction of change is good news. Delta colour follows meaning, not sign: a latency drop is an improvement under `lower-is-better`, and a `neutral` metric never claims a direction is good or bad.",
              "name": "polarity",
              "required": false,
              "type": "KpiPolarity",
              "vocabulary": [
                "higher-is-better",
                "lower-is-better",
                "neutral"
              ]
            },
            {
              "default": "\"neutral\"",
              "deprecatedValues": [
                {
                  "note": "`brand` is an emphasis, not a tone (ADR 0026). Removed next release.",
                  "value": "brand"
                }
              ],
              "description": "What the metric means: the shared tone vocabulary (ADR 0026), each on its Feedback Role's surface with its paired readable foreground. Defaults to `neutral`. `brand` is deprecated for one release.",
              "name": "tone",
              "required": false,
              "type": "KpiCardTone | DeprecatedKpiCardTone",
              "vocabulary": [
                "neutral",
                "info",
                "success",
                "warning",
                "danger"
              ]
            },
            {
              "description": "Optional chart content, normally a Sparkline imported by the caller.",
              "name": "sparkline",
              "required": false,
              "type": "ReactNode"
            },
            {
              "default": "\"\"",
              "description": "Extra classes, merged over the root slot's own, onto the card's root `section`.",
              "name": "className",
              "required": false,
              "type": "string"
            }
          ],
          "source": "kits/data/react/src/KpiCard.tsx",
          "specifier": "@reddb-io/design-system/data/KpiCard"
        },
        "readiness": {
          "adoptionReadiness": "not-declared"
        },

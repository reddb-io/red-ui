        },
        {
          "declaration": "/** Pure path operations for the Data Kit TreeView. This module has no Svelte or DOM dependency. */\n\nexport interface TreeNode<Value = unknown> {\n  /** Stable node identity. Path-built nodes use their normalized full path. */\n  id: string;\n  /** Visible node name. */\n  label: string;\n  /** Caller-owned value when this node represents an input path. */\n  value?: Value;\n  children: readonly TreeNode<Value>[];\n}",
          "name": "TreeNode",
          "source": "kits/data/src/tree.ts"
        },
        {
          "declaration": "/** A caller-owned move proposed by the TreeView's drag-and-drop affordance. */\nexport interface TreeReorder {\n  sourceId: string;\n  targetId: string;\n  position: TreeReorderPosition;\n}",
          "name": "TreeReorder",
          "source": "kits/data/src/tree.ts"
        },
        {
          "declaration": "export type TreeReorderPosition = \"before\" | \"after\" | \"inside\";",
          "name": "TreeReorderPosition",
          "source": "kits/data/src/tree.ts"
        }
      ]
    },
    "events": [
      {
        "description": "Reports the expanded node ids after a node opens or closes.",
        "dialect": "state",
        "name": "onexpandedchange",
        "type": "(expanded: readonly string[]) => void"
      },
      {
        "description": "Reports the selected node id after the selection moves.",
        "dialect": "state",
        "name": "onselectedchange",
        "type": "(selected: string | null) => void"
      },
      {
        "description": "Receives a committed rename: the node and its new label.",
        "dialect": "discrete",
        "name": "onrename",
        "type": "(node: TreeNode, label: string) => void"
      },
      {
        "description": "Receives a dropped move.",
        "dialect": "discrete",
        "name": "onreorder",
        "type": "(move: TreeReorder) => void"
      },
      {
        "description": "Called when the person retries after a failed load.",
        "dialect": "discrete",
        "name": "onretry",
        "type": "() => void"
      }
    ],
    "implementations": {
      "react": {
        "api": {
          "forwardsNativeProps": false,
          "kind": "Composite",
          "kit": "data",
          "name": "TreeView",
          "nativeAttributes": [],
          "props": [
            {
              "description": "Where the data stands. Unset means ready, and empty when there are no items. `refreshing` keeps the items and marks the collection busy; `error` with items keeps them as stale under an alert.",
              "name": "state",
              "required": false,
              "type": "CollectionState",
              "vocabulary": [
                "loading",
                "ready",
                "empty",
                "error",
                "refreshing"
              ]
            },
            {
              "default": "\"Could not load the tree.\"",
              "description": "Message shown when the data failed to load.",
              "name": "errorMessage",
              "required": false,
              "type": "string"
            },
            {

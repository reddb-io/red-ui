      "types": [
        {
          "declaration": "/** Pure path operations for the Data Kit TreeView. This module has no Svelte or DOM dependency. */\n\nexport interface TreeNode<Value = unknown> {\n  /** Stable node identity. Path-built nodes use their normalized full path. */\n  id: string;\n  /** Visible node name. */\n  label: string;\n  /** Caller-owned value when this node represents an input path. */\n  value?: Value;\n  children: readonly TreeNode<Value>[];\n}",
          "name": "TreeNode",
          "source": "kits/data/src/tree.ts"
        },
        {
          "declaration": "/** A caller-owned move proposed by the TreeView's drag-and-drop affordance. */\nexport interface TreeReorder {\n  sourceId: string;\n  targetId: string;\n  position: TreeReorderPosition;\n}",
          "name": "TreeReorder",
          "source": "kits/data/src/tree.ts"
        },
        {
          "declaration": "export type TreeReorderPosition = \"before\" | \"after\" | \"inside\";",
          "name": "TreeReorderPosition",
          "source": "kits/data/src/tree.ts"
        }
      ]

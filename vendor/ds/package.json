      "types": "./kits/app/src/core/workspace-documents.ts",
      "default": "./kits/app/src/core/workspace-documents.ts"
    },
    "./app/workspace/execution": {
      "types": "./kits/app/src/core/workspace-execution.ts",
      "default": "./kits/app/src/core/workspace-execution.ts"
    },

{
  "name": "@reddb-io/ui-mcp",
  "version": "0.7.22",
  "private": false,
  "description": "MCP Apps server for embedding RedDB UI in MCP clients.",
  "type": "module",
  "bin": {
    "ui-mcp": "./dist/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "tools/prestart.mjs"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepack": "pnpm build",
    "build": "node tools/build.mjs",
    "check": "node tools/build.mjs --check",
    "test": "pnpm build && node test/mcp-app-smoke.mjs && node test/target-mode.test.mjs && node test/local-server.test.mjs && node test/embed-server.test.mjs && node test/data-tools.test.mjs && node test/adapter-client.test.mjs",
    "prestart": "node tools/prestart.mjs",
    "start": "node dist/index.js --stdio"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "^1.7.2",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "tsx": "^4.22.3",
    "typescript": "^5.7.2"
  },
  "license": "Apache-2.0",
  "homepage": "https://github.com/reddb-io/red-ui",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/reddb-io/red-ui.git",
    "directory": "packages/mcp"
  },
  "bugs": {
    "url": "https://github.com/reddb-io/red-ui/issues"
  }
}

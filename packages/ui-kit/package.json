{
  "name": "@reddb-io/ui-kit",
  "version": "0.4.2",
  "private": false,
  "description": "Low-level RedDB UI design-system primitives.",
  "type": "module",
  "exports": {
    ".": {
      "svelte": "./src/lib/index.ts",
      "types": "./src/lib/index.ts"
    },
    "./tokens": "./src/tokens/index.ts",
    "./tokens.css": "./src/tokens/tokens.css",
    "./styles.css": "./src/tokens/styles.css"
  },
  "files": [
    "src/lib",
    "src/tokens"
  ],
  "publishConfig": {
    "access": "public",
    "directory": ".package",
    "linkDirectory": false
  },
  "scripts": {
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "prepack": "node ../../scripts/package-with-design-system.mjs ui-kit"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "svelte": "^5.20.0",
    "svelte-check": "^4.1.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  },
  "dependencies": {
    "@reddb-io/design-system": "workspace:*",
    "@lucide/svelte": "^1.0.1"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "Apache-2.0",
  "homepage": "https://github.com/reddb-io/red-ui",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/reddb-io/red-ui.git",
    "directory": "packages/ui-kit"
  },
  "bugs": {
    "url": "https://github.com/reddb-io/red-ui/issues"
  }
}
